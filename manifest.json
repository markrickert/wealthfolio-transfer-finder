{
  "id": "wealthfolio-transfers",
  "name": "Transfer Finder",
  "version": "0.1.1",
  "description": "Find likely transfer pairs in activity history and link them",
  "author": "Mark Rickert",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.0",
  "enabled": true,
  "contributes": {
    "routes": [{ "id": "wealthfolio-transfers" }],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-transfers",
          "route": "wealthfolio-transfers",
          "label": "Transfers",
          "icon": "plugs-connected",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "permissions": [
    {
      "category": "activities",
      "functions": [
        "search",
        "update",
        "getTransferPair",
        "findTransferMatchCandidates",
        "linkTransfer"
      ],
      "purpose": "Detect and link internal transfer pairs"
    }
  ],
  "network": {
    "allowedHosts": []
  },
  "keywords": ["wealthfolio", "addon", "transfers", "transfer-finder"],
  "license": "MIT"
}
