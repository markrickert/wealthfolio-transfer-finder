{
  "name": "wealthfolio-transfer-finder-addon",
  "version": "0.1.0",
  "description": "Find likely transfer pairs in activity history and link them",
  "type": "module",
  "main": "dist/addon.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "wealthfolio",
    "addon",
    "transfers",
    "transfer-finder"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "package": "mkdir -p dist && find dist -name '*.map' -delete && zip -r dist/$npm_package_name-$npm_package_version.zip manifest.json dist/ assets/ README.md -x '*.map' 'images/*' 'images/**'",
    "bundle": "pnpm clean && pnpm build && pnpm package",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --write"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.6.2",
    "@wealthfolio/ui": "^3.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.20",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@wealthfolio/addon-dev-tools": "link:../wealthfolio/packages/addon-dev-tools",
    "@wealthfolio/addon-sdk": "link:../wealthfolio/packages/addon-sdk",
    "@wealthfolio/ui": "link:../wealthfolio/packages/ui",
    "date-fns": "^4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "lucide-react": "^0.561.0",
    "prettier": "^3.9.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
